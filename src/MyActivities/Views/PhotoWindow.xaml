<ui:FluentWindow x:Class="MyActivities.Views.PhotoWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Foto"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Foto" />

        <Image x:Name="Picture" Grid.Row="1" Margin="12" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <ui:ProgressRing x:Name="Busy" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="PrevButton" Grid.Column="0" Icon="{ui:SymbolIcon ChevronLeft24}" Click="OnPrev" />
            <ui:TextBlock x:Name="Caption" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
            <ui:Button Grid.Column="2" Margin="0,0,8,0" Content="Im Explorer zeigen"
                       Icon="{ui:SymbolIcon Folder24}" Click="OnShowInExplorer" />
            <ui:Button x:Name="NextButton" Grid.Column="3" Icon="{ui:SymbolIcon ChevronRight24}" Click="OnNext" />
        </Grid>
    </Grid>
</ui:FluentWindow>
