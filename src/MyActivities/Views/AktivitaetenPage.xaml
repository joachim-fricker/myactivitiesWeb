<Page x:Class="MyActivities.Views.AktivitaetenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      ScrollViewer.CanContentScroll="False"
      Title="Aktivitäten">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Kopf mit Filtern -->
        <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <ui:Button x:Name="BackToMapButton" Margin="0,0,16,0" Content="Zurück zur Karte"
                       Icon="{ui:SymbolIcon ArrowLeft24}" Visibility="Collapsed" Click="OnBackToMapClick" />
            <ui:TextBlock Text="Aktivitäten" FontTypography="Title" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox x:Name="QuickBox" Width="140" Margin="0,0,8,0" SelectedIndex="0"
                      SelectionChanged="OnQuickChanged">
                <ComboBoxItem Content="Alle" />
                <ComboBoxItem Content="Radfahren" />
                <ComboBoxItem Content="Wandern" />
                <ComboBoxItem Content="Skitouren" />
            </ComboBox>
            <ComboBox x:Name="SubBox" Width="140" Margin="0,0,8,0" Visibility="Collapsed"
                      SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="YearBox" Width="130" Margin="0,0,8,0"
                      SelectionChanged="OnFilterChanged" />
            <ui:TextBox x:Name="SearchBox" Width="220" PlaceholderText="Suche Name oder Ort"
                        TextChanged="OnSearchChanged" />
        </WrapPanel>

        <ui:TextBlock x:Name="SummaryText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,8" />

        <!-- Tabelle -->
        <DataGrid x:Name="Table" Grid.Row="2" Grid.Column="0"
                  Style="{StaticResource Table}" AutoGenerateColumns="False"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DateColumn" Header="Datum"
                                    Binding="{Binding Start, StringFormat=dd.MM.yyyy}" SortMemberPath="Start"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="Typ" Binding="{Binding TypeLabel}"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="km" Binding="{Binding Km, StringFormat=N1}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Hm" Binding="{Binding ElevationGain, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Zeit" Binding="{Binding DurationText}" SortMemberPath="DurationS"
                                    ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Grid.Column="1" Width="12" HorizontalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- Details -->
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <ui:TextBlock x:Name="DetailName" FontTypography="Subtitle" TextWrapping="Wrap"
                              Text="Aktivität in der Tabelle auswählen" />
                <ui:TextBlock x:Name="DetailSub" Margin="0,2,0,0" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:TextBlock x:Name="DetailLocation" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <UniformGrid x:Name="Tiles" Grid.Row="1" Columns="3" Margin="0,12,0,12" Visibility="Collapsed">
                <ui:Card Margin="0,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="Distanz" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock x:Name="TileKm" FontTypography="BodyStrong" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="Aufstieg" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock x:Name="TileHm" FontTypography="BodyStrong" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4,0,0,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="Dauer" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBlock x:Name="TileTime" FontTypography="BodyStrong" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <Border Grid.Row="2" CornerRadius="6" ClipToBounds="True">
                <wv2:WebView2 x:Name="Map" />
            </Border>
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock x:Name="TrackStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="EnlargeButton" Grid.Column="1" Content="Karte vergrößern"
                           Icon="{ui:SymbolIcon FullScreenMaximize24}" IsEnabled="False"
                           Click="OnEnlargeClick" />
            </Grid>

            <!-- Fotos zur Tour -->
            <StackPanel x:Name="PhotoPanel" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
                <ui:TextBlock x:Name="PhotoHeader" FontTypography="BodyStrong" Margin="0,0,0,4" />
                <ListBox x:Name="PhotoList" Height="104" Padding="0,0,0,14"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnPhotoClick" KeyDown="OnPhotoKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="112" Height="76" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    ToolTip="{Binding Taken, StringFormat=HH:mm}">
                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <ui:Card Grid.Row="5" Margin="0,8,0,0" Padding="12,8">
                <ItemsControl x:Name="DetailList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="{Binding Key}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>

            <ui:Button x:Name="GarminButton" Grid.Row="6" Margin="0,12,0,0" Visibility="Collapsed"
                       Content="In Garmin Connect öffnen" Icon="{ui:SymbolIcon Open24}"
                       Click="OnGarminClick" />
        </Grid>
    </Grid>
</Page>
