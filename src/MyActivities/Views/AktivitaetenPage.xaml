<Page x:Class="MyActivities.Views.AktivitaetenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      ScrollViewer.CanContentScroll="False"
      Title="Aktivitäten">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- Kopf mit Filtern -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <ui:TextBlock Text="Aktivitäten" FontTypography="Title" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox x:Name="QuickBox" Width="140" Margin="0,0,8,0" SelectedIndex="0"
                      SelectionChanged="OnQuickChanged">
                <ComboBoxItem Content="Alle" />
                <ComboBoxItem Content="Radfahren" />
                <ComboBoxItem Content="Wandern" />
                <ComboBoxItem Content="Skitouren" />
            </ComboBox>
            <ComboBox x:Name="SubBox" Width="140" Margin="0,0,8,0" Visibility="Collapsed"
                      SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="YearBox" Width="130" Margin="0,0,8,0"
                      SelectionChanged="OnFilterChanged" />
            <ui:TextBox x:Name="SearchBox" Width="220" PlaceholderText="Suche Name oder Ort"
                        TextChanged="OnSearchChanged" />
            <ui:ToggleSwitch x:Name="IndoorSwitch" Margin="16,0,0,0" VerticalAlignment="Center"
                             Content="Indoor-Rad" IsChecked="False" Click="OnIndoorClick" />
        </WrapPanel>

        <ui:TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,12,0,8" />

        <!-- Tabelle (Doppelklick oder Enter öffnet die Details) -->
        <DataGrid x:Name="Table" Grid.Row="2"
                  Style="{StaticResource Table}" AutoGenerateColumns="False"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnTableDoubleClick" PreviewKeyDown="OnTableKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DateColumn" Header="Datum"
                                    Binding="{Binding Start, StringFormat=dd.MM.yyyy}" SortMemberPath="Start"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" MaxWidth="370"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="Typ" Binding="{Binding TypeLabel}"
                                    ElementStyle="{StaticResource LeftCell}" />
                <DataGridTextColumn Header="km" Binding="{Binding Km, StringFormat=N1}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Hm" Binding="{Binding ElevationGain, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Zeit" Binding="{Binding DurationText}" SortMemberPath="DurationS"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Ø km/h" Binding="{Binding AvgKmh, StringFormat=N1}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Max km/h" Binding="{Binding MaxKmh, StringFormat=N1}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Höchster Pkt." Binding="{Binding MaxElev, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="5 min W" Binding="{Binding BestP5W, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="10 min W" Binding="{Binding BestP10W, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="20 min W" Binding="{Binding BestP20W, StringFormat=N0}"
                                    ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

        <!-- Karte der ausgewählten Tour -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock x:Name="TrackStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                              Text="Tour in der Tabelle auswählen" />
                <ui:Button x:Name="DetailsButton" Grid.Column="1" Margin="8,0,0,0" Content="Details"
                           Appearance="Primary" Icon="{ui:SymbolIcon Info24}" IsEnabled="False"
                           Click="OnDetailsClick" />
                <ui:Button x:Name="EnlargeButton" Grid.Column="2" Margin="8,0,0,0" Content="Karte vergrößern"
                           Icon="{ui:SymbolIcon FullScreenMaximize24}" IsEnabled="False"
                           Click="OnEnlargeClick" />
            </Grid>
            <wv2:WebView2 x:Name="Map" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
