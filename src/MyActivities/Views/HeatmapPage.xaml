<Page x:Class="MyActivities.Views.HeatmapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      ScrollViewer.CanContentScroll="False"
      Title="Heatmap">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <ui:TextBlock Text="Heatmap" FontTypography="Title" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox x:Name="GroupBox" Width="140" Margin="0,0,8,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Alle" />
                <ComboBoxItem Content="Rad" />
                <ComboBoxItem Content="Wandern" />
                <ComboBoxItem Content="Skitour" />
                <ComboBoxItem Content="Sonstige" />
            </ComboBox>
            <ComboBox x:Name="YearBox" Width="130" Margin="0,0,24,0" SelectionChanged="OnFilterChanged" />
            <ui:Button Content="Alle zeigen" Icon="{ui:SymbolIcon ZoomFit24}" Click="OnShowAllClick" />
        </WrapPanel>

        <ui:TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,8" TextWrapping="Wrap" />

        <wv2:WebView2 x:Name="Map" Grid.Row="2" />

        <!-- Touren, die am angeklickten Punkt vorbeiführen -->
        <StackPanel x:Name="NearPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock x:Name="NearHeader" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Click="OnCloseNear" ToolTip="Liste schließen" />
            </Grid>
            <DataGrid x:Name="NearTable" Style="{StaticResource Table}" AutoGenerateColumns="False"
                      MaxHeight="220" SelectionChanged="OnNearSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Start, StringFormat=dd.MM.yyyy}"
                                        SortMemberPath="Start" ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MaxWidth="370"
                                        ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding TypeLabel}"
                                        ElementStyle="{StaticResource LeftCell}" />
                    <DataGridTextColumn Header="km" Binding="{Binding Km, StringFormat=N1}"
                                        ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Hm" Binding="{Binding ElevationGain, StringFormat=N0}"
                                        ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Zeit" Binding="{Binding DurationText}" SortMemberPath="DurationS"
                                        ElementStyle="{StaticResource RightCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
