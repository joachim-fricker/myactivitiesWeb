<Page x:Class="MyActivities.Views.KartePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      ScrollViewer.CanContentScroll="False"
      Title="Karte">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <ui:TextBlock Text="Karte" FontTypography="Title" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox x:Name="GroupBox" Width="140" Margin="0,0,8,0" SelectedIndex="0"
                      SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Alle" />
                <ComboBoxItem Content="Rad" />
                <ComboBoxItem Content="Wandern" />
                <ComboBoxItem Content="Skitour" />
                <ComboBoxItem Content="Sonstige" />
            </ComboBox>
            <ComboBox x:Name="YearBox" Width="130" Margin="0,0,24,0" SelectionChanged="OnFilterChanged" />
            <ui:Button x:Name="OpenInViewButton" Margin="0,0,8,0" Content="Tracks im Bereich öffnen"
                       Icon="{ui:SymbolIcon Map24}" Click="OnOpenInViewClick" Visibility="Collapsed" />
            <ui:Button Margin="0,0,8,0" Content="Alle zeigen"
                       Icon="{ui:SymbolIcon ZoomFit24}" Click="OnShowAllClick" />
            <ui:Button x:Name="HideTracksButton" Margin="0,0,8,0" Visibility="Collapsed"
                       Icon="{ui:SymbolIcon EyeOff24}" Click="OnHideTracksClick" />
            <ui:TextBlock x:Name="ViewText" VerticalAlignment="Center" Margin="8,0,0,0" FontTypography="BodyStrong" />
        </WrapPanel>

        <ui:TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,12,0,8" TextWrapping="Wrap" />

        <wv2:WebView2 x:Name="Map" Grid.Row="2" />

        <!-- Fotos der geöffneten Touren -->
        <StackPanel x:Name="AreaPhotoPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <ui:TextBlock x:Name="AreaPhotoHeader" FontTypography="BodyStrong" Margin="0,0,0,4" />
            <ListBox x:Name="AreaPhotoList" Height="104" Padding="0,0,0,14"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonUp="OnAreaPhotoClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="112" Height="76" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                ToolTip="{Binding Description}">
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
